<!-- KAYIT MODAL -->
<div class="modal-bg" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">×</button>
    <h3>HESAP OLUŞTUR</h3>
    <p>Ücretsiz başla, istediğin zaman yükselt.</p>
    <div class="form-group">
      <label>Yayıncı Adın</label>
      <input type="text" placeholder="ör: oyuncu_ahmet">
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" placeholder="email@adresin.com">
    </div>
    <div class="form-group">
      <label>Şifre</label>
      <input type="password" placeholder="En az 8 karakter">
    </div>
    <div class="form-group">
      <label>Yayın Kategorisi</label>
      <select>
        <option>🎮 Oyun Yayını</option>
        <option>🎵 Müzik</option>
        <option>💬 Sohbet</option>
        <option>📚 Eğitim</option>
        <option>🎨 Sanat & Tasarım</option>
        <option>🏋️ Spor & Fitness</option>
      </select>
    </div>
    <button class="modal-submit" onclick="submitForm()">Ücretsiz Başla →</button>
  </div>
</div>

<script>
function openModal(){document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
function toggleFaq(el){
  const item=el.closest('.faq-item');
  const isOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!isOpen)item.classList.add('open');
}
function submitForm(){
  const btn=document.querySelector('.modal-submit');
  btn.textContent='Hesap oluşturuluyor...';
  setTimeout(()=>{
    btn.textContent='✓ Hoş geldin! Yönlendiriliyorsun...';
    btn.style.background='#00d4aa';
    setTimeout(closeModal,2000);
  },1500);
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
</script>
